# =============================================================================
# Competitive Intelligence Tracker - Backend Environment
# =============================================================================

# --- Application ---
APP_NAME=Competitive Intelligence Tracker
APP_ENV=development
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Database (SQLite by default — no setup required) ---
# Uncomment and set DATABASE_URL for PostgreSQL/Supabase in production:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=sqlite+aiosqlite:///./ci_tracker.db

# --- AI (Google Gemini 2.5 Flash) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Notifications (Resend) ---
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Competitive Intelligence <ci@yourdomain.com>
DIGEST_RECIPIENTS=["team@yourdomain.com"]

# --- Web Scraping Fallback (Jina Reader) ---
JINA_READER_BASE_URL=https://r.jina.ai/
JINA_API_KEY=your_jina_api_key_optional

# --- Scheduler ---
SCAN_HOUR_UTC=2
SCAN_MINUTE_UTC=0

# --- Security ---
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
