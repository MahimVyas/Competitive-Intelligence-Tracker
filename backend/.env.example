# =============================================================================
# Competitive Intelligence Tracker - Backend Environment
# =============================================================================
# Copy this file to .env and fill in your values.
# Required: GEMINI_API_KEY (for AI diff analysis)
# Optional: RESEND_API_KEY (for email digests), DATABASE_URL (defaults to SQLite)
# =============================================================================

# --- Application ---
APP_NAME=Competitive Intelligence Tracker
APP_ENV=development
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Database (SQLite by default — no setup required) ---
# Uncomment and set for PostgreSQL/Supabase in production:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB

# --- AI (Google Gemini 2.5 Flash) — REQUIRED for diff analysis ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Notifications (Resend) — Optional, for email digests ---
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Competitive Intelligence <ci@yourdomain.com>
DIGEST_RECIPIENTS=["team@yourdomain.com"]

# --- Web Scraping Fallback (Jina Reader) ---
JINA_READER_BASE_URL=https://r.jina.ai/
JINA_API_KEY=

# --- Scheduler ---
SCAN_HOUR_UTC=2
SCAN_MINUTE_UTC=0

# --- Security ---
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
